{
  "name": "trae-on-campus-beijing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/content.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run build && npm test && npm run test:browser",
    "share-image": "node scripts/share-image.mjs",
    "format": "prettier --write src scripts tests package.json",
    "format:check": "prettier --check src scripts tests package.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9"
  }
}
